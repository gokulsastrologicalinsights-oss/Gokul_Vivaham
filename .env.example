NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server only. Never add NEXT_PUBLIC_ to this key.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret-key
# Staging must use a separate Supabase project and Razorpay TEST keys.
RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-server-only-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-separate-webhook-secret
