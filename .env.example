NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
# Server only. Never add NEXT_PUBLIC_ to this key.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret-key
# Cloudflare R2 server-only storage credentials
STORAGE_BACKEND=r2
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PROFILE_PHOTOS_BUCKET=your-photos-bucket
R2_HOROSCOPES_BUCKET=your-horoscopes-bucket
R2_ID_PROOFS_BUCKET=your-id-proofs-bucket
# Staging must use a separate Supabase project and Razorpay TEST keys.
RAZORPAY_KEY_ID=your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=your-server-only-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-separate-webhook-secret
